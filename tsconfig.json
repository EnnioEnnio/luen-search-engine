{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./static",
    "rootDir": "./static",
    "removeComments": true
  },
  "include": [
    "static/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
